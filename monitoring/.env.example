# ─── Grafana Admin ────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_strong_password

# Port Grafana will be available on (default 3000)
GRAFANA_PORT=3000

# Full public URL of Grafana (used for links in alerts, etc.)
# Example: http://yourserver.com:3000  or  https://grafana.yourserver.com
GRAFANA_ROOT_URL=http://localhost:3000

# ─── Site 1: client1.abc.com ──────────────────────────────────────────────────
# Host where MariaDB is running as seen from Docker
# On Linux servers: use host.docker.internal (Docker 20.10+) or the server's LAN IP
SITE1_DB_HOST=host.docker.internal
SITE1_DB_PORT=3306
SITE1_DB_NAME=client1_abc_com
SITE1_DB_USER=client1_abc_com
SITE1_DB_PASSWORD=YOUR_SITE1_DB_PASSWORD_HERE

# ─── Site 2: client1.localhost ────────────────────────────────────────────────
SITE2_DB_HOST=host.docker.internal
SITE2_DB_PORT=3306
SITE2_DB_NAME=client1_abc_com
SITE2_DB_USER=client1_abc_com
SITE2_DB_PASSWORD=YOUR_SITE2_DB_PASSWORD_HERE

# ─── Phase 2: ActivityWatch / Prometheus ─────────────────────────────────────
# Port employee PCs push data to (open this in your server firewall)
PROMETHEUS_PUBLIC_PORT=9091

# How long Prometheus keeps activity data
PROMETHEUS_RETENTION=90d

# Bearer token for securing the remote-write endpoint
# Generate with:  openssl rand -hex 32
# This same token must be set in each employee's aw-sync-settings.yaml
PROMETHEUS_BEARER_TOKEN=your_strong_random_token_here

# ─── Adding more sites ────────────────────────────────────────────────────────
# To add a 2nd site, add SITE2_* variables here and update:
#   grafana/provisioning/datasources/erpnext.yml  (add datasource entry)
