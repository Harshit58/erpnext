{
  "title": "Tridev Activity Watcher - Employee Desktop Activity",
  "uid": "activitywatch-v1",
  "description": "Tracks active applications, browser usage, idle time and work hours per employee — powered by Tridev Activity Watcher",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "2m",
  "timezone": "browser",
  "tags": ["tridev", "activity-watcher", "employees", "desktop"],
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "time": { "from": "now-8h", "to": "now" },
  "timepicker": {},
  "links": [],
  "annotations": { "list": [] },
  "templating": {
    "list": [
      {
        "name": "employee",
        "label": "Employee",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "tridev-aw-prometheus" },
        "query": "label_values(hostname)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "hide": 0,
        "sort": 1
      },
      {
        "name": "bucket",
        "label": "Watcher",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "tridev-aw-prometheus" },
        "query": "label_values(bucket)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "hide": 0,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Setup Instructions",
      "type": "text",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 0 },
      "options": {
        "mode": "markdown",
        "content": "## Tridev Activity Watcher\n\n**No data yet?** Each employee needs to:\n1. Install the **Tridev Activity Watcher** agent on their computer (see `employee-setup/README.md`)\n2. Install the **browser extension** (Chrome/Firefox)\n3. Run the **sync agent** — one command provided by admin\n\nOnce agents are running, data appears here within 5 minutes.\n\n> **Tip:** Use the `Employee` dropdown above to filter by specific employee. Names are set automatically from the employee's computer hostname."
      }
    },
    {
      "id": 2,
      "title": "Active Time Today (per Employee)",
      "description": "Total non-AFK (actively working) time per employee today",
      "type": "stat",
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "tridev-aw-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 14400 },
              { "color": "green", "value": 21600 }
            ]
          },
          "unit": "s",
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "tridev-aw-prometheus" },
          "expr": "sum by (hostname) (increase(aw_event_duration_seconds{bucket=~\"aw-watcher-afk.*\", status=\"not-afk\", hostname=~\"$employee\"}[8h]))",
          "legendFormat": "{{hostname}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Idle Time Today (per Employee)",
      "description": "Total AFK (away from keyboard) time per employee today",
      "type": "stat",
      "gridPos": { "h": 5, "w": 8, "x": 8, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "tridev-aw-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 3600 },
              { "color": "red", "value": 7200 }
            ]
          },
          "unit": "s",
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "tridev-aw-prometheus" },
          "expr": "sum by (hostname) (increase(aw_event_duration_seconds{bucket=~\"aw-watcher-afk.*\", status=\"afk\", hostname=~\"$employee\"}[8h]))",
          "legendFormat": "{{hostname}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Employees Currently Online",
      "description": "Employees who sent data in the last 10 minutes",
      "type": "stat",
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "tridev-aw-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null }
            ]
          },
          "unit": "short",
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "tridev-aw-prometheus" },
          "expr": "count(count by (hostname) (aw_event_duration_seconds{hostname=~\"$employee\"} offset 0m))",
          "legendFormat": "Online Now",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Active vs Idle Time Over Time",
      "description": "Timeline showing when employees were actively working vs idle",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "tridev-aw-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 1,
            "stacking": { "group": "A", "mode": "normal" }
          },
          "unit": "s",
          "mappings": []
        },
        "overrides": [
          {
            "matcher": { "id": "byFrameRefID", "options": "B" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }
            ]
          }
        ]
      },
      "options": {
        "legend": { "calcs": ["sum"], "displayMode": "table", "placement": "right", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "tridev-aw-prometheus" },
          "expr": "sum by (hostname) (rate(aw_event_duration_seconds{bucket=~\"aw-watcher-afk.*\", status=\"not-afk\", hostname=~\"$employee\"}[$__rate_interval]))",
          "legendFormat": "Active - {{hostname}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "tridev-aw-prometheus" },
          "expr": "sum by (hostname) (rate(aw_event_duration_seconds{bucket=~\"aw-watcher-afk.*\", status=\"afk\", hostname=~\"$employee\"}[$__rate_interval]))",
          "legendFormat": "Idle - {{hostname}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 6,
      "title": "Top Applications Used",
      "description": "Most used desktop applications across all employees (by time spent)",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 17 },
      "datasource": { "type": "prometheus", "uid": "tridev-aw-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "fillOpacity": 80,
            "gradientMode": "none",
            "lineWidth": 1
          },
          "unit": "s",
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "barRadius": 0.05,
        "barWidth": 0.9,
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": false },
        "orientation": "horizontal",
        "showValue": "always",
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "tridev-aw-prometheus" },
          "expr": "topk(10, sum by (app) (increase(aw_event_duration_seconds{bucket=~\"aw-watcher-window.*\", hostname=~\"$employee\"}[$__range])))",
          "legendFormat": "{{app}}",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "id": 7,
      "title": "Top Websites Visited",
      "description": "Most visited websites by time spent (from browser extension)",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 17 },
      "datasource": { "type": "prometheus", "uid": "tridev-aw-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 1
          },
          "unit": "s",
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "barRadius": 0.05,
        "barWidth": 0.9,
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": false },
        "orientation": "horizontal",
        "showValue": "always",
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "tridev-aw-prometheus" },
          "expr": "topk(10, sum by (url) (increase(aw_event_duration_seconds{bucket=~\"aw-watcher-web.*\", hostname=~\"$employee\"}[$__range])))",
          "legendFormat": "{{url}}",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "id": 8,
      "title": "Per Employee — App Usage Breakdown",
      "description": "Time each employee spent in each application",
      "type": "table",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 25 },
      "datasource": { "type": "prometheus", "uid": "tridev-aw-prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" },
            "inspect": false
          },
          "unit": "s",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Time Spent" },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": { "type": "color-background", "mode": "basic" }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "yellow", "value": 1800 },
                    { "color": "red", "value": 7200 }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "cellHeight": "sm",
        "footer": { "show": false },
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "Time Spent" }]
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "tridev-aw-prometheus" },
          "expr": "sort_desc(sum by (hostname, app) (increase(aw_event_duration_seconds{bucket=~\"aw-watcher-window.*\", hostname=~\"$employee\"}[$__range])))",
          "legendFormat": "{{hostname}} | {{app}}",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        { "id": "labelsToFields", "options": { "mode": "columns" } },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "hostname": "Employee",
              "app": "Application",
              "Value": "Time Spent"
            }
          }
        }
      ]
    }
  ]
}
