server {
    listen 9091;
    server_name _;

    # ── Health check endpoint ────────────────────────────────────────────────
    # aw-sync-agent calls GET <PrometheusUrl>/-/healthy to check connectivity.
    # Requires valid Bearer token; returns 200 so the agent proceeds to sync.
    location = /-/healthy {
        if ($http_authorization != "Bearer ${PROMETHEUS_BEARER_TOKEN}") {
            return 401 '{"error":"Unauthorized"}';
        }
        return 200 '{"status":"ok"}';
    }

    # ── Remote Write endpoint ────────────────────────────────────────────────
    # aw-sync-agent POSTs to <PrometheusUrl>/api/v1/write with protobuf data.
    # Requires valid Bearer token; proxies directly to Prometheus.
    location /api/v1/write {
        if ($http_authorization != "Bearer ${PROMETHEUS_BEARER_TOKEN}") {
            return 401 '{"error":"Unauthorized"}';
        }
        proxy_pass         http://prometheus:9090/api/v1/write;
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_read_timeout 30s;
    }

    # ── Block all other Prometheus endpoints from public access ──────────────
    location / {
        return 403 '{"error":"Forbidden"}';
    }
}
