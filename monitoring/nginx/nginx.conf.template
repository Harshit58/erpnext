server {
    listen 9091;
    server_name _;

    # ── Remote Write endpoint ────────────────────────────────────────────────
    # Employee PCs running aw-sync-agent push ActivityWatch data here.
    # Requires the Authorization: Bearer <token> header.
    location /api/v1/write {
        if ($http_authorization != "Bearer ${PROMETHEUS_BEARER_TOKEN}") {
            return 401 '{"error":"Unauthorized"}';
        }
        proxy_pass         http://prometheus:9090/api/v1/write;
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_read_timeout 30s;
    }

    # ── Block all other Prometheus endpoints from public access ──────────────
    location / {
        return 403 '{"error":"Forbidden"}';
    }
}
